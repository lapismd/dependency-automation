{
  "name": "@lapismd/dependency-automation",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "check": "prettier --check . && node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "inventory": "node scripts/inventory.mjs",
    "renovate:validate": "renovate-config-validator",
    "verify": "pnpm check && pnpm test"
  },
  "dependencies": {
    "minimatch": "11.0.3",
    "semver": "7.8.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "prettier": "3.7.4",
    "renovate": "44.199.0"
  }
}
